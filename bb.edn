{:paths ["bb" "test"]
 :tasks
 {installer-help {:doc "Print the MPLAB X installer help."
                  :requires ([installer-help :as installer-help])
                  :task (apply installer-help/main *command-line-args*)}
  packs {:doc "List bundled or online MPLAB packs."
         :requires ([packs :as packs])
         :task (apply packs/main *command-line-args*)}
  project-config {:doc "Print xc-cli settings for an MPLAB project."
                  :requires ([project-config :as project-config])
                  :task (apply project-config/main *command-line-args*)}
  ci-image {:doc "Build a CI image from compiler/pack arguments or an MPLAB project."
            :requires ([ci-image :as ci-image])
            :task (apply ci-image/main *command-line-args*)}
  package {:doc "Preview or add a compiler package from a Linux installer URL."
           :requires ([compiler-package :as package])
           :task (apply package/main *command-line-args*)}
  test {:doc "Test checkout tasks without compiler downloads or installations."
        :requires ([clojure.test :as test] [ci-image-test] [project-config-test]
                   [compiler-package-test])
        :task (let [{:keys [fail error]}
                    (test/run-tests 'ci-image-test 'project-config-test 'compiler-package-test)]
                (when (pos? (+ fail error)) (System/exit 1)))}}}
